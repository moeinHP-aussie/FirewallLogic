# Demo firewall policy for Phase 4
# This is a fictional university network policy.  It intentionally contains
# several policy anomalies so that the reporting screen has useful output.

*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# INPUT: campus services
-A INPUT -s 10.10.0.0/16 -d 192.168.50.10 -p tcp --dport 22 -j ACCEPT
-A INPUT -s 10.10.25.0/24 -d 192.168.50.10 -p tcp --dport 22 -j DROP
-A INPUT -s 10.11.0.0/16 -d 192.168.50.53 -p udp --dport 53 -j ACCEPT
-A INPUT -s 10.11.0.0/16 -d 192.168.50.53 -p udp --dport 53 -j ACCEPT
-A INPUT -s 10.12.1.0/24 -d 192.168.50.20 -p tcp --dport 443 -j ACCEPT
-A INPUT -s 10.12.2.0/24 -d 192.168.50.20 -p tcp --dport 443 -j ACCEPT
-A INPUT -s 10.13.0.0/16 -d 192.168.50.25 -p tcp --dport 25 -j ACCEPT
-A INPUT -s 10.14.0.0/16 -d 192.168.50.30 -p tcp --dport 3306 -j DROP

# FORWARD: students, laboratories and data-centre access
-A FORWARD -s 10.20.0.0/16 -d 172.16.10.10 -p tcp --dport 443 -j ACCEPT
-A FORWARD -s 10.20.5.0/24 -d 172.16.10.10 -p tcp --dport 443 -j ACCEPT
-A FORWARD -s 10.30.0.0/24 -d 172.20.10.128/25 -p tcp --dport 80:100 -j ACCEPT
-A FORWARD -s 10.30.0.128/25 -d 172.20.10.0/24 -p tcp --dport 90:110 -j DROP
-A FORWARD -s 10.40.10.10 -d 172.16.20.15 -p tcp --dport 22 -j DROP
-A FORWARD -s 10.40.0.0/16 -d 172.16.20.15 -p tcp --dport 22 -j ACCEPT
-A FORWARD -s 10.50.0.0/16 -d 172.16.30.10 -p tcp --dport 443 -j ACCEPT
-A FORWARD -s 10.51.0.0/16 -d 172.16.30.10 -p tcp --dport 443 -j ACCEPT
-A FORWARD -s 10.52.0.0/16 -d 172.16.40.5 -p udp --dport 1194 -j ACCEPT
-A FORWARD -s 10.53.0.0/16 -d 172.16.41.5 -p tcp --dport 3389 -j DROP
-A FORWARD -s 10.54.0.0/16 -d 172.16.42.20 -p tcp --dport 5432 -j ACCEPT
-A FORWARD -s 10.55.0.0/16 -d 172.16.43.20 -p tcp --dport 6379 -j DROP
-A FORWARD -s 10.56.0.0/16 -d 172.16.44.100 -p tcp --dport 8080 -j ACCEPT
-A FORWARD -s 10.57.0.0/16 -d 172.16.45.100 -p udp --dport 161 -j ACCEPT
-A FORWARD -s 10.58.0.0/16 -d 172.16.46.100 -p udp --dport 162 -j DROP

